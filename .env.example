# ==============================================================================
# REDGRID PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: This file contains variable names and safe placeholders only.
# Never commit real secrets or production credentials to this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel / Vite Client)
# ------------------------------------------------------------------------------
# VITE_API_URL: Base URL of the backend API service (e.g. https://api.redgrid.app)
# Leave empty for local development / monolithic single-origin mode.
VITE_API_URL=

# VITE_WS_URL: URL of the persistent WebSocket / Socket.IO service (e.g. wss://api.redgrid.app)
# If omitted, defaults to VITE_API_URL or current browser window location.
VITE_WS_URL=

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Node.js Service)
# ------------------------------------------------------------------------------
# NODE_ENV: Application runtime mode ('development' | 'production')
NODE_ENV=production

# PORT: Server listener port (Default: 3000)
PORT=3000

# DATABASE_URL: Neon PostgreSQL connection string with SSL enabled
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# JWT_SECRET: High-entropy secret key for signing JSON Web Tokens (min 32 chars)
JWT_SECRET=

# JWT_EXPIRES_IN: Token expiration duration (Default: 7d)
JWT_EXPIRES_IN=7d

# CORS_ORIGIN: Comma-separated list of allowed frontend origins (e.g. https://redgrid.vercel.app)
CORS_ORIGIN=

# GEMINI_API_KEY: Google Gemini API key for Dr. Clara AI assistant
GEMINI_API_KEY=

# DONOR_MATCH_RADIUS_KM: Geographic Haversine matching radius in kilometers (Default: 10)
DONOR_MATCH_RADIUS_KM=10
